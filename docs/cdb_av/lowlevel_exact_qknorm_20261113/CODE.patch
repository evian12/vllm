+    att.q_norm=nn.Identity();att.k_norm=nn.Identity();att.rotary_emb=Rotate()
+    att.attn=Attend()
+    def replacement(module,pos,qkv):
+        return qkv[:,:2048]+1,qkv[:,2048:3072]+1
+    att._cdb_exact_qknorm=replacement if hook else None
